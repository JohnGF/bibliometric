# OpenAlex API - Polite Pool (Specify email to access the polite pool for faster/reliable query rates)
OPENALEX_EMAIL="your-email@example.com"

# Crossref API - User-Agent Header (Specify email to be polite and avoid rate blocks)
CROSSREF_EMAIL="your-email@example.com"

# PubMed API Key (Obtain from your NCBI Account Settings under developer API keys)
PUBMED_API_KEY="your_pubmed_api_key_here"

# Elsevier Scopus API Key (Obtain from https://dev.elsevier.com/ - requires institution network or token)
SCOPUS_API_KEY="your_scopus_api_key_here"

# IEEE Xplore API Key (Obtain from https://developer.ieee.org/)
IEEE_API_KEY="your_ieee_api_key_here"

# Semantic Scholar API Key (Obtain from https://www.semanticscholar.org/product/api)
SS_API_KEY="your_semanticscholar_key_here"

# Web of Science API Key (Obtain from https://developer.clarivate.com/ - requires subscription)
WOS_API_KEY="your_wos_key_here"
